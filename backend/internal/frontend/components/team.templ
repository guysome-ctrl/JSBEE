package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var teamInfo = pageInfo{
	title:       "Our team | JSBEE core members and city leaders",
	description: "Meet the JSBEE team — student core members and city leaders building an open-access research journal for sustainability, business and economics.",
	canonical:   "/team",
}

templ teamPage() {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "team")
		<header class="jsbee-band bg-[#16211B]">
			<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
				<p class="font-serif text-lg italic text-[#B9C2B2]">Who leads where</p>
				<h1 class="mt-3 font-serif text-4xl font-semibold text-[#F2F3EA] sm:text-5xl">Our team</h1>
				<p class="mt-4 max-w-2xl leading-relaxed text-[#B9C2B2]">
					The core members building JSBEE, and the city leaders representing it.
				</p>
				if contactEmail() != "" {
					<p class="mt-3 max-w-2xl leading-relaxed text-[#B9C2B2]">
						Want to become a city leader? <a href={ templ.SafeURL("mailto:" + contactEmail()) } class="font-medium text-[#F2F3EA] underline underline-offset-4 hover:text-white">Email us</a>
					</p>
				}
			</div>
		</header>
		<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
			<div class="flex gap-2 border-b border-[#DDD5C2]" role="tablist">
				<button
					id="tab-core"
					type="button"
					role="tab"
					class="border-b-2 border-[#33523B] px-4 py-2.5 text-sm font-semibold text-stone-900"
				>
					Core members
				</button>
				<button
					id="tab-leaders"
					type="button"
					role="tab"
					class="border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-stone-500 hover:text-stone-900"
				>
					City leaders
				</button>
			</div>
			<div id="panel-core" class="mt-8">
				<div id="core-loading" class="text-center text-sm text-stone-500">Loading core members...</div>
				<div id="core-error" class="hidden text-center text-sm text-[#7F1D1D]"></div>
				<p id="core-empty" class="hidden text-center text-sm text-stone-500">No core members yet.</p>
				<div id="core-list" class="hidden grid gap-10"></div>
				<noscript>
					<p class="leading-relaxed text-stone-600">
						JSBEE is built by student core members working across
						research, content, partnerships, finance, technology
						and outreach.
						Enable JavaScript to meet the team, or start from
						<a href="/" class="font-medium text-[#33523B] hover:underline hover:underline-offset-4">the homepage</a>.
					</p>
				</noscript>
			</div>
			<div id="panel-leaders" class="hidden">
				<div id="team-loading" class="mt-8 text-center text-sm text-stone-500">Loading team...</div>
				<div id="team-error" class="mt-8 hidden text-center text-sm text-[#7F1D1D]"></div>
				<p id="team-empty" class="mt-8 hidden text-center text-sm text-stone-500">No city leaders yet.</p>
				<ul id="team-list" class="mt-8 hidden border-t border-[#DDD5C2]"></ul>
			</div>
		</main>
		@siteFooter(provider.SiteName)
		<script>
			(function() {
				var uuidPattern = /^[0-9a-fA-F-]{36}$/;
				var activeTab = 'border-b-2 border-[#33523B] px-4 py-2.5 text-sm font-semibold text-stone-900';
				var inactiveTab = 'border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-stone-500 hover:text-stone-900';

				function selectTab(which) {
					var core = which === 'core';
					document.getElementById('panel-core').classList.toggle('hidden', !core);
					document.getElementById('panel-leaders').classList.toggle('hidden', core);
					document.getElementById('tab-core').className = core ? activeTab : inactiveTab;
					document.getElementById('tab-leaders').className = core ? inactiveTab : activeTab;
				}

				function el(tag, className, text) {
					var node = document.createElement(tag);
					if (className) {
						node.className = className;
					}
					if (text != null) {
						node.textContent = text;
					}
					return node;
				}

				function coreCard(member, last) {
					var articleClass = 'border-t border-[#DDD5C2] pt-6';
					if (last) {
						articleClass += ' border-b pb-6';
					}
					var article = el('article', articleClass);
					var head = el('div', 'flex gap-5');
					var img = document.createElement('img');
					img.className = 'h-24 w-24 shrink-0 rounded-[3px] object-cover';
					img.alt = member.name || 'Core member';
					img.loading = 'lazy';
					if (typeof member.image_url === 'string' && member.image_url) {
						img.src = member.image_url;
					}
					head.appendChild(img);
					var titles = el('div');
					titles.appendChild(el(
						'h3',
						'font-serif text-xl font-semibold text-stone-900',
						member.name || 'Unknown'
					));
					titles.appendChild(el(
						'p',
						'mt-1 text-sm font-medium text-[#33523B]',
						member.role || ''
					));
					head.appendChild(titles);
					article.appendChild(head);
					var paras = typeof member.description === 'string' ?
						member.description.split('\n\n') : [];
					paras.forEach(function(para, j) {
						var paraClass =
							'text-sm leading-relaxed text-stone-600';
						paraClass += (j === 0 ? ' mt-4' : ' mt-3');
						article.appendChild(el('p', paraClass, para));
					});
					return article;
				}

				function loadCoreMembers() {
					var loading = document.getElementById('core-loading');
					var errorEl = document.getElementById('core-error');
					var emptyEl = document.getElementById('core-empty');
					var list = document.getElementById('core-list');

					fetchWithRetry('/api/v1/core-members')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load core members');
						})
						.then(function(resp) {
							return resp.json();
						})
						.then(function(data) {
							var raw = (data && data.core_members) || [];
							var members = Array.isArray(raw) ? raw : [];
							members = members.filter(function(m) {
								return m && typeof m.uuid === 'string' && uuidPattern.test(m.uuid) &&
									typeof m.name === 'string' && m.name &&
									typeof m.role === 'string' && m.role &&
									typeof m.description === 'string' && m.description;
							});
							loading.classList.add('hidden');
							if (!members.length) {
								emptyEl.classList.remove('hidden');
								return;
							}
							members.forEach(function(member, i) {
								list.appendChild(coreCard(member, i === members.length - 1));
							});
							list.classList.remove('hidden');
						})
						.catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = 'Failed to load core members: ' + err.message;
							errorEl.classList.remove('hidden');
						});
				}

				function initTeam() {
					document.getElementById('tab-core').addEventListener('click', function() {
						selectTab('core');
					});
					document.getElementById('tab-leaders').addEventListener('click', function() {
						selectTab('leaders');
					});

					loadCoreMembers();

					var loading = document.getElementById('team-loading');
					var errorEl = document.getElementById('team-error');
					var emptyEl = document.getElementById('team-empty');
					var list = document.getElementById('team-list');

					fetchWithRetry('/api/v1/leaders')
						.then(function(resp) {
							return checkApiResponse(resp, 'Failed to load team');
						})
						.then(function(resp) {
							return resp.json();
						})
						.then(function(data) {
							var leaders = (data && Array.isArray(data.leaders)) ? data.leaders : [];
							loading.classList.add('hidden');
							if (!leaders.length) {
								emptyEl.classList.remove('hidden');
								return;
							}
							leaders.forEach(function(leader) {
								if (typeof leader.uuid !== 'string' || !uuidPattern.test(leader.uuid)) {
									return;
								}
								var li = document.createElement('li');
								li.className = 'border-b border-[#E7E0CF] last:border-0';
								var link = document.createElement('a');
								link.href = '/author?uuid=' + encodeURIComponent(leader.uuid);
								link.className = 'jsbee-row-hover flex items-baseline justify-between gap-4 px-3 py-5';
								var name = document.createElement('span');
								name.className = 'font-serif text-xl font-semibold text-stone-900';
								name.textContent = leader.name || 'Unknown';
								link.appendChild(name);
								if (leader.city_lead) {
									var city = document.createElement('span');
									city.className = 'shrink-0 text-sm font-medium text-[#33523B]';
									city.textContent = leader.city_lead;
									link.appendChild(city);
								}
								li.appendChild(link);
								list.appendChild(li);
							});
							if (!list.children.length) {
								emptyEl.classList.remove('hidden');
								return;
							}
							list.classList.remove('hidden');
						})
						.catch(function(err) {
							loading.classList.add('hidden');
							errorEl.textContent = 'Failed to load team: ' + err.message;
							errorEl.classList.remove('hidden');
						});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initTeam);
				} else {
					initTeam();
				}
			})();
		</script>
	</div>
}

templ TeamPage(firebaseClientConfig map[string]any) {
	@base(teamInfo, teamPage(), firebaseClientConfig)
}

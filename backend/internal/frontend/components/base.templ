package components

import "github.com/Ankumeah/JSBEE/backend/internal/provider"

templ base(info pageInfo, content templ.Component, firebaseClientConfig map[string]any) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ info.description }/>
			<meta name="google-site-verification" content={ provider.GoogleSEOTagContent }/>
			if info.robots != "" {
				<meta name="robots" content={ info.robots }/>
			} else {
				<meta name="robots" content="index, follow"/>
			}
			<meta name="author" content="JSBEE"/>
			<meta name="theme-color" content="#16211B"/>
			<link rel="canonical" href={ provider.SiteURL + info.canonical }/>
			<meta property="og:site_name" content="JSBEE"/>
			<meta property="og:title" content={ info.title }/>
			<meta property="og:description" content={ info.description }/>
			if info.ogType != "" {
				<meta property="og:type" content={ info.ogType }/>
			} else {
				<meta property="og:type" content="website"/>
			}
			<meta property="og:url" content={ provider.SiteURL + info.canonical }/>
			<meta property="og:image" content={ provider.SiteURL + "/favicon.png" }/>
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:title" content={ info.title }/>
			<meta name="twitter:description" content={ info.description }/>
			<meta name="twitter:image" content={ provider.SiteURL + "/favicon.png" }/>
			<title>{ info.title }</title>
			<link rel="icon" href="/favicon.png" type="image/png"/>
			<link rel="apple-touch-icon" href="/favicon.png"/>
			@jsonLD()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<style>
			[x-cloak] { display: none !important; }
			html, body { overflow-x: clip; }
			@media (prefers-reduced-motion: no-preference) {
				html { scroll-behavior: smooth; }
			}
			body { font-family: "Source Sans 3", system-ui, sans-serif; background: #FAF7EF; }
			.font-serif { font-family: "Source Serif 4", Georgia, serif; }
			::selection { background: #33523B; color: #F5F6EF; }
			:focus-visible { outline: 2px solid #33523B; outline-offset: 2px; }
			/* Full-bleed band: stretches edge-to-edge inside a centered container. */
			.jsbee-band { position: relative; left: 50%; width: 100vw; margin-left: -50vw; }
			/* Journal index row: hairline rule with dotted leader between title and meta. */
			.jsbee-leader { display: none; flex: 1 1 auto; margin: 0 0.75rem; border-bottom: 1px dotted #A8A094; transform: translateY(-4px); }
			@media (min-width: 640px) {
				.jsbee-leader { display: block; }
			}
			/* Editorial drop cap for pull-quote paragraphs. */
			.jsbee-dropcap::first-letter {
				font-family: "Source Serif 4", Georgia, serif;
				font-weight: 600;
				font-size: 3.1em;
				float: left;
				line-height: 0.9;
				padding-right: 0.12em;
				color: #33523B;
			}
			/* Single orchestrated entrance: hero only. Everything else is static. */
			@keyframes jsbee-fade-up {
				from { opacity: 0; transform: translateY(14px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.jsbee-hero-enter { animation: jsbee-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
			.jsbee-d1 { animation-delay: 90ms; }
			.jsbee-d2 { animation-delay: 180ms; }
			.jsbee-d3 { animation-delay: 270ms; }
			.jsbee-d4 { animation-delay: 360ms; }
			/* Quiet buttons: a 1px lift, no glow. */
			.jsbee-btn { transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease; }
			.jsbee-btn:hover { transform: translateY(-1px); }
			/* Index rows: warm wash on hover, no cards, no shadows. */
			.jsbee-row-hover { transition: background-color 0.2s ease; }
			.jsbee-row-hover:hover { background: #F2EDE1; }
			/* Statistics: tabular figures so count-ups don't jitter. */
			.jsbee-stat-num { font-variant-numeric: tabular-nums; }
			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				.jsbee-hero-enter { animation: none; }
			}
				.blog-content { line-height: 1.8; color: #44403c; overflow-wrap: break-word; }
				.blog-content h1, .blog-content h2, .blog-content h3, .blog-content h4 { font-weight: 600; color: #1c1917; margin: 1.5em 0 0.5em; line-height: 1.3; }
				.blog-content h1 { font-size: 1.875rem; }
				.blog-content h2 { font-size: 1.5rem; }
				.blog-content h3 { font-size: 1.25rem; }
				.blog-content p { margin: 1em 0; }
				.blog-content ul, .blog-content ol { margin: 1em 0; padding-left: 1.5em; }
				.blog-content ul { list-style-type: disc; }
				.blog-content ol { list-style-type: decimal; }
				.blog-content li { margin: 0.25em 0; }
				.blog-content a { color: #33523B; font-weight: 500; }
				.blog-content a:hover { text-decoration: underline; }
				.blog-content code { font-family: ui-monospace, monospace; font-size: 0.875em; background: #F2EDE1; border-radius: 0.25rem; padding: 0.125rem 0.375rem; }
				.blog-content pre { background: #1c1917; color: #e7e5e4; border-radius: 0.5rem; padding: 1rem; overflow-x: auto; margin: 1em 0; }
				.blog-content pre code { background: transparent; padding: 0; color: inherit; }
				.blog-content blockquote { border-left: 0.25rem solid #d6d3d1; padding-left: 1rem; margin: 1em 0; color: #78716c; font-style: italic; }
				.blog-content img { max-width: 100%; border-radius: 0.5rem; }
				.blog-content hr { border-color: #e7e5e4; margin: 2em 0; }
			</style>
			<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
			<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.9/dist/purify.min.js"></script>
			<script>
				const firebaseApp = firebase.initializeApp({{ firebaseClientConfig }});
				const firebaseAuth = firebase.auth();

				function firebaseSignIn() {
					if (firebaseAuth.currentUser) {
						return firebaseAuth.currentUser.getIdToken(true);
					}
					const provider = new firebase.auth.GoogleAuthProvider();
					return firebaseAuth.signInWithPopup(provider).then(function(result) {
						return result.user.getIdToken();
					});
				}

				function firebaseSignOut() {
					localStorage.removeItem('firebase_jwt');
					localStorage.removeItem('jsbee_uuid');
					_authReadyPromise = null;
					return firebaseAuth.signOut();
				}

				function firebaseRefreshToken() {
					if (!firebaseAuth.currentUser) {
						return Promise.reject(new Error('No user signed in'));
					}
					return firebaseAuth.currentUser.getIdToken(true);
				}

				function getFirebaseJwt() {
					return localStorage.getItem('firebase_jwt');
				}

				function setFirebaseJwt(token) {
					localStorage.setItem('firebase_jwt', token);
				}

				function getFirebaseUuid() {
					return localStorage.getItem('jsbee_uuid');
				}

				function setFirebaseUuid(uuid) {
					localStorage.setItem('jsbee_uuid', uuid);
				}

				function clearFirebaseSession() {
					localStorage.removeItem('firebase_jwt');
					localStorage.removeItem('jsbee_uuid');
				}

				function checkApiResponse(resp, fallback) {
					if (resp.ok) {
						return Promise.resolve(resp);
					}
					return resp.text().then(function(text) {
						var message = fallback || 'Request failed';
						try {
							var parsed = JSON.parse(text);
							if (parsed && parsed.error) {
								message = parsed.error;
							} else if (text) {
								message = text;
							}
						} catch (e) {
							if (text) {
								message = text;
							}
						}
						console.warn('API request failed:', resp.url, resp.status, text);
						var err = new Error(message);
						err.status = resp.status;
						throw err;
					});
				}

				function isSessionExpiredError(err) {
					return err && err.status === 401;
				}

				// Transient-failure retry with exponential backoff.
				// Only network errors plus HTTP 429 / 5xx are retried; other
				// statuses (400, 401, 403, 404, ...) fail fast so the caller
				// can show the real error. Intermediate failures are silent:
				// after `retries` is exhausted the last response (or network
				// error) is returned/thrown, so the caller's existing
				// checkApiResponse + catch path shows the eventual error
				// message to the user.
				// Usage: fetchWithRetry('/api/v1/blogs', {}, { retries: 3, baseDelayMs: 500, onRetry: function(n, max) {} });
				function jsbeeSleep(ms) {
					return new Promise(function(resolve) {
						setTimeout(resolve, ms);
					});
				}

				function jsbeeRetryDelayMs(retryIndex, baseDelayMs, maxDelayMs) {
					var base = baseDelayMs || 500;
					var max = maxDelayMs || 4000;
					var exp = base * Math.pow(2, retryIndex);
					var capped = Math.min(exp, max);
					return capped + Math.floor(Math.random() * Math.min(capped * 0.25, 500));
				}

				function jsbeeIsRetryableStatus(status) {
					return status === 429 || (status >= 500 && status <= 599);
				}

				function jsbeeWithRetry(sender, retryOptions) {
					var opts = retryOptions || {};
					var maxRetries = typeof opts.retries === 'number' ? opts.retries : 3;
					var baseDelayMs = opts.baseDelayMs || 500;
					var maxDelayMs = opts.maxDelayMs || 4000;
					var onRetry = opts.onRetry;
					var attemptsUsed = 0;
					function notifyRetry() {
						if (typeof onRetry === 'function') {
							try {
								onRetry(attemptsUsed, maxRetries);
							} catch (e) {}
						}
					}
					function scheduleRetry() {
						attemptsUsed += 1;
						notifyRetry();
						return jsbeeSleep(jsbeeRetryDelayMs(attemptsUsed - 1, baseDelayMs, maxDelayMs)).then(attemptSend);
					}
					function attemptSend() {
						return sender().then(function(resp) {
							if (resp && attemptsUsed < maxRetries && jsbeeIsRetryableStatus(resp.status)) {
								return scheduleRetry();
							}
							return resp;
						}, function(networkErr) {
							if (attemptsUsed >= maxRetries) {
								throw networkErr;
							}
							return scheduleRetry();
						});
					}
					return attemptSend();
				}

				function fetchWithRetry(url, options, retryOptions) {
					return jsbeeWithRetry(function() {
						return fetch(url, options);
					}, retryOptions);
				}

				// Same retry policy for authenticated API calls. Each attempt
				// goes through authFetch (fresh token + its single 401
				// reauth); 401/403 responses are never retried here.
				function authFetchWithRetry(path, options, retryOptions) {
					return jsbeeWithRetry(function() {
						return authFetch(path, options);
					}, retryOptions);
				}

				function handleSessionExpired() {
					_authReadyPromise = null;
					firebaseAuth.signOut().catch(function() {});
					clearFirebaseSession();
					showAuthFailedToast('Session expired, please sign in again');
				}

				function showAuthFailedToast(message) {
					showToastWithActions(message, [
						{
							label: 'Cancel',
							pressed: function() {
								hideToast();
							}
						},
						{
							label: 'Log out',
							danger: true,
							pressed: function() {
								hideToast();
								firebaseSignOut().then(function() {
									window.location.href = '/';
								}).catch(function() {
									window.location.href = '/';
								});
							}
						}
					]);
				}

				var _authReadyPromise = null;

				function waitForAuthUser() {
					if (firebaseAuth.currentUser) {
						return Promise.resolve(firebaseAuth.currentUser);
					}
					if (!_authReadyPromise) {
						_authReadyPromise = new Promise(function(resolve) {
							var unsub = firebaseAuth.onAuthStateChanged(function(user) {
								try {
									unsub();
								} catch (e) {}
								resolve(user || null);
							});
						});
					}
					return _authReadyPromise;
				}

				function reauthenticate() {
					_authReadyPromise = null;
					return firebaseAuth.signOut().catch(function() {}).then(function() {
						clearFirebaseSession();
						return firebaseSignIn();
					}).then(function(idToken) {
						setFirebaseJwt(idToken);
						return idToken;
					}, function(err) {
						if (err && (err.code === 'auth/popup-blocked' || err.code === 'auth/popup-closed-by-user' || err.code === 'auth/cancelled-popup-request')) {
							throw new Error('Please sign in again to continue');
						}
						throw err;
					});
				}

				function getValidToken() {
					return waitForAuthUser().then(function(user) {
						if (!user) {
							return null;
						}
						return user.getIdToken(false).then(function(token) {
							setFirebaseJwt(token);
							return token;
						}, function() {
							_authReadyPromise = null;
							return firebaseAuth.signOut().catch(function() {}).then(function() {
								clearFirebaseSession();
								return null;
							});
						});
					});
				}

				function authFetch(path, options) {
					options = options || {};
					function send(token) {
						var headers = {};
						if (options.headers) {
							for (var key in options.headers) {
								headers[key] = options.headers[key];
							}
						}
						headers['Authorization'] = 'Bearer ' + token;
						return fetch(path, {
							method: options.method || 'GET',
							headers: headers,
							body: options.body
						});
					}
					return getValidToken().then(function(token) {
						if (!token) {
							var err = new Error('Not signed in');
							err.status = 401;
							throw err;
						}
						return send(token).then(function(resp) {
							if (resp.status !== 401) {
								return resp;
							}
							return reauthenticate().then(send);
						});
					});
				}

				function ensureSignedIn() {
					return waitForAuthUser().then(function(user) {
						if (!user) {
							return firebaseSignIn();
						}
						return user.getIdToken().then(function(idToken) {
							return idToken;
						}, function() {
							return reauthenticate();
						});
					}).then(function(idToken) {
						return fetchWithRetry('/api/v1/account', {
							method: 'POST',
							headers: { 'Authorization': 'Bearer ' + idToken }
						}).then(function(resp) {
							return checkApiResponse(resp, 'Backend registration failed');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.uuid) {
								throw new Error('Backend registration failed: missing user id');
							}
							setFirebaseUuid(data.uuid);
							return firebaseRefreshToken();
						});
					}).then(function(refreshedToken) {
						setFirebaseJwt(refreshedToken);
						return refreshedToken;
					});
				}

				firebaseAuth.onIdTokenChanged(function(user) {
					if (user) {
						user.getIdToken().then(function(token) {
							setFirebaseJwt(token);
						}).catch(function() {});
					}
				});

				function hideToast() {
					var body = document.getElementById('toast-body');
					if (!body) {
						return;
					}
					body.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
					body.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
				}

				function showToast(message) {
					var body = document.getElementById('toast-body');
					var msg = document.getElementById('toast-msg');
					var actionsEl = document.getElementById('toast-actions');
					if (!body || !msg || !actionsEl) {
						return;
					}
					msg.textContent = message;
					actionsEl.innerHTML = '';
					body.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
					body.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
				}

				function showToastWithActions(message, actions) {
					var body = document.getElementById('toast-body');
					var msg = document.getElementById('toast-msg');
					var actionsEl = document.getElementById('toast-actions');
					if (!body || !msg || !actionsEl) {
						return;
					}
					msg.textContent = message;
					actionsEl.innerHTML = '';
					(actions || []).forEach(function(action) {
						var btn = document.createElement('button');
						btn.type = 'button';
						btn.textContent = action.label;
						btn.className = action.danger
							? 'rounded-[3px] bg-[#7F1D1D] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#671818]'
							: 'rounded-[3px] border border-white/20 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-white/10';
						btn.addEventListener('click', function() {
							action.pressed();
						});
						actionsEl.appendChild(btn);
					});
				body.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
				body.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
			}

			// Animated statistics: counts up once visible, honours reduced motion.
			// Usage: jsbeeCountUp(document.getElementById('stat-papers'), 128);
			function jsbeeCountUp(node, target) {
				if (!node) {
					return;
				}
				target = Math.max(0, Math.round(target || 0));
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					node.textContent = target.toLocaleString();
					return;
				}
				if (!('IntersectionObserver' in window)) {
					node.textContent = target.toLocaleString();
					return;
				}
				var started = false;
				var observer = new IntersectionObserver(function(entries) {
					if (started) {
						return;
					}
					var visible = entries.some(function(entry) {
						return entry.isIntersecting;
					});
					if (!visible) {
						return;
					}
					started = true;
					observer.disconnect();
					var duration = 900;
					var t0 = null;
					function frame(now) {
						if (t0 === null) {
							t0 = now;
						}
						var progress = Math.min(1, (now - t0) / duration);
						var eased = 1 - Math.pow(1 - progress, 3);
						node.textContent = Math.round(target * eased).toLocaleString();
						if (progress < 1) {
							requestAnimationFrame(frame);
						}
					}
					requestAnimationFrame(frame);
				}, { threshold: 0.4 });
				observer.observe(node);
			}
		</script>
		</head>
		<body class="min-h-screen bg-[#FAF7EF] font-sans text-stone-800 antialiased">
			@content
			@popUp("")
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
		</body>
	</html>
}

package components

import (
	"github.com/Ankumeah/JSBEE/backend/internal/provider"
)

var adminInfo = pageInfo{
	title:       "Admin | JSBEE",
	description: "Admin dashboard.",
	canonical:   "/admin",
	robots:      "noindex, nofollow",
}

templ adminPage(aboutURL string) {
	<div class="flex min-h-screen flex-col">
		@navBar(provider.SiteName, "")
		<main class="flex flex-1 flex-col md:flex-row">
			<aside class="top-0 z-10 w-full shrink-0 border-b border-[#DDD5C2] bg-[#F5F6EF] px-4 py-4 md:sticky md:h-screen md:w-56 md:border-b-0 md:border-r md:py-12 md:pl-4 md:pr-2">
				<nav class="flex gap-1 overflow-x-auto md:flex-col md:space-y-1 md:overflow-visible">
					<button
						type="button"
						id="sidebar-welcome"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 bg-stone-200"
					>
						Welcome
					</button>
					<button
						type="button"
						id="sidebar-publish"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						Publish
						<span id="publish-badge" class="ml-2 hidden rounded-full bg-[#33523B] px-2 py-0.5 text-xs font-semibold text-white"></span>
					</button>
					<button
						type="button"
						id="sidebar-volume-issue"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						New volume or issue
					</button>
					<button
						type="button"
						id="sidebar-roles"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						Roles
					</button>
					<button
						type="button"
						id="sidebar-blog"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						Blog
					</button>
					<button
						type="button"
						id="sidebar-about"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						About
					</button>
					<button
						type="button"
						id="sidebar-team"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						Team
					</button>
					<button
						type="button"
						id="sidebar-core-members"
						class="sidebar-item shrink-0 md:w-full rounded-[3px] px-3 py-2 text-left text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
					>
						Core members
					</button>
				</nav>
			</aside>
			<div class="flex-1 px-4 py-12 sm:px-6">
				<div class="mx-auto max-w-3xl">
					<h1 class="border-b border-[#DDD5C2] pb-4 text-left font-serif text-4xl font-semibold text-stone-900">Admin dashboard</h1>
					<div id="admin-error" class="mt-8 hidden text-center text-sm text-[#7F1D1D]"></div>
					<div id="panel-welcome" class="mt-8 text-center text-lg text-stone-700">
						Welcome, You are trusted
					</div>
					<div id="panel-publish" class="hidden mt-8">
						<div id="publish-loading" class="text-center text-sm text-stone-500">Loading reviewed papers...</div>
						<div id="publish-empty" class="hidden text-center text-sm text-stone-500">
							No papers waiting to be published.
						</div>
						<div id="publish-content" class="hidden">
							<div class="mb-4 flex items-center justify-between">
								<span id="publish-count" class="text-sm text-stone-600"></span>
								<button
									type="button"
									id="btn-publish"
									class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D]"
								>
									Publish all
								</button>
							</div>
							<ul id="publish-list" class="divide-y divide-[#E7E0CF] border border-[#DDD5C2] bg-white/60 p-4 shadow-sm"></ul>
						</div>
					</div>
					<div id="panel-volume-issue" class="hidden mt-8 flex flex-col items-center gap-4">
						<button
							type="button"
							id="btn-new-volume"
							class="w-full max-w-xs rounded-[3px] bg-[#1C1917] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-stone-700"
						>
							New Volume
						</button>
						<button
							type="button"
							id="btn-new-issue"
							class="w-full max-w-xs rounded-[3px] bg-[#1C1917] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-stone-700"
						>
							New Issue
						</button>
					</div>
					<div id="panel-roles" class="hidden mt-8">
						<div class="mx-auto max-w-xl space-y-4">
							<div class="flex flex-col gap-2 sm:flex-row">
								<input
									id="role-email"
									type="email"
									placeholder="user@example.com"
									class="flex-1 rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
								/>
								<button
									type="button"
									id="btn-find-user"
									class="rounded-[3px] bg-[#1C1917] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-stone-700"
								>
									Find user
								</button>
							</div>
							<div id="role-error" class="hidden text-center text-sm text-[#7F1D1D]"></div>
							<div
								id="role-result"
								class="hidden border border-[#DDD5C2] bg-white/60 p-6 shadow-sm"
							>
								<dl class="space-y-4 text-sm">
									<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
										<dt class="font-medium text-stone-500">Name</dt>
										<dd id="role-name" class="text-stone-900"></dd>
									</div>
									<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
										<dt class="font-medium text-stone-500">Email</dt>
										<dd id="role-current-email" class="text-stone-900"></dd>
									</div>
									<div class="flex items-center justify-between gap-4">
										<dt class="font-medium text-stone-500">Current role</dt>
										<dd id="role-current" class="text-stone-900"></dd>
									</div>
								</dl>
								<div class="mt-4 flex flex-col gap-2 sm:flex-row">
									<select
										id="role-select"
										class="flex-1 rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none disabled:opacity-50"
									>
										<option value="owner">owner</option>
										<option value="viewer">viewer</option>
										<option value="reviewer">reviewer</option>
										<option value="admin">admin</option>
									</select>
									<button
										type="button"
										id="btn-change-role"
										class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D] disabled:opacity-50"
									>
										Change role
									</button>
								</div>
								<p id="role-owner-note" class="mt-3 hidden text-sm text-[#7F1D1D]">The owner's role cannot be changed.</p>
							</div>
						</div>
					</div>
					<div id="panel-blog" class="hidden mt-8">
						<div class="mx-auto max-w-3xl space-y-6">
							<div>
								<h2 class="font-serif text-xl font-semibold text-stone-900">Posts</h2>
								<div id="blog-admin-loading" class="mt-2 text-sm text-stone-500">Loading posts...</div>
								<div id="blog-admin-empty" class="mt-2 hidden text-sm text-stone-500">No posts yet.</div>
								<ul id="blog-admin-list" class="mt-2 hidden divide-y divide-[#E7E0CF] border border-[#DDD5C2] bg-white/60 p-4 shadow-sm"></ul>
							</div>
							<div class="border border-[#DDD5C2] bg-white/60 p-6 shadow-sm">
								<h2 id="blog-editor-heading" class="font-serif text-xl font-semibold text-stone-900">New post</h2>
								<label class="mt-4 block">
									<span class="text-sm font-medium text-stone-700">Title</span>
									<input
										id="blog-title"
										type="text"
										placeholder="Post title"
										class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
									/>
								</label>
								<div class="mt-4 grid gap-4 md:grid-cols-2">
									<div>
										<span class="text-sm font-medium text-stone-700">Markdown</span>
										<textarea
											id="blog-editor"
											rows="12"
											placeholder="# Hello&#10;&#10;Write your post in markdown..."
											class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 font-mono text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
										></textarea>
									</div>
									<div>
										<span class="text-sm font-medium text-stone-700">Preview</span>
										<div id="blog-preview" class="blog-content mt-1 min-h-[12rem] rounded-[3px] border border-stone-200 bg-white px-3 py-2 text-sm"></div>
									</div>
								</div>
								<div class="mt-4 flex gap-2">
									<button
										type="button"
										id="btn-blog-save"
										class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D]"
									>
										Publish post
									</button>
									<button
										type="button"
										id="btn-blog-cancel"
										class="hidden rounded-[3px] border border-[#DDD5C2] px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-[#F2EDE1]"
									>
										Cancel editing
									</button>
								</div>
							</div>
						</div>
					</div>
					<div id="panel-about" class="hidden mt-8">
						<div class="mx-auto max-w-3xl space-y-4">
							<div class="border border-[#DDD5C2] bg-white/60 p-6 shadow-sm">
								<h2 class="font-serif text-xl font-semibold text-stone-900">About us page</h2>
								<p class="mt-1 text-sm text-stone-500">Shown in the footer of every page.</p>
								<div id="about-admin-loading" class="mt-4 text-sm text-stone-500">Loading current content...</div>
								<div class="mt-4 grid gap-4 md:grid-cols-2">
									<div>
										<span class="text-sm font-medium text-stone-700">Markdown</span>
										<textarea
											id="about-editor"
											rows="12"
											class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 font-mono text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
										></textarea>
									</div>
									<div>
										<span class="text-sm font-medium text-stone-700">Preview</span>
										<div id="about-preview" class="blog-content mt-1 min-h-[12rem] rounded-[3px] border border-stone-200 bg-white px-3 py-2 text-sm"></div>
									</div>
								</div>
								<div class="mt-4">
									<button
										type="button"
										id="btn-about-save"
										class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D]"
									>
										Save about page
									</button>
								</div>
							</div>
						</div>
					</div>
					<div id="panel-team" class="hidden mt-8">
						<div class="mx-auto max-w-xl space-y-4">
							<div class="flex flex-col gap-2 sm:flex-row">
								<input
									id="team-email"
									type="email"
									placeholder="user@example.com"
									class="flex-1 rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
								/>
								<button
									type="button"
									id="btn-find-team-user"
									class="rounded-[3px] bg-[#1C1917] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-stone-700"
								>
									Find user
								</button>
							</div>
							<div id="team-error" class="hidden text-center text-sm text-[#7F1D1D]"></div>
							<div
								id="team-result"
								class="hidden border border-[#DDD5C2] bg-white/60 p-6 shadow-sm"
							>
								<dl class="space-y-4 text-sm">
									<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
										<dt class="font-medium text-stone-500">Name</dt>
										<dd id="team-name" class="text-stone-900"></dd>
									</div>
									<div class="flex items-center justify-between gap-4 border-b border-stone-100 pb-3">
										<dt class="font-medium text-stone-500">Email</dt>
										<dd id="team-current-email" class="text-stone-900"></dd>
									</div>
									<div class="flex items-center justify-between gap-4">
										<dt class="font-medium text-stone-500">Current city lead</dt>
										<dd id="team-current-lead" class="text-stone-900"></dd>
									</div>
								</dl>
								<div class="mt-4 flex flex-col gap-2 sm:flex-row">
									<input
										id="team-input"
										type="text"
										maxlength="120"
										placeholder="City name"
										class="flex-1 rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none disabled:opacity-50"
									/>
									<button
										type="button"
										id="btn-save-team-lead"
										class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D] disabled:opacity-50"
									>
										Save
									</button>
									<button
										type="button"
										id="btn-clear-team-lead"
										class="rounded-[3px] bg-[#7F1D1D] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#671818] disabled:opacity-50"
									>
										Clear
									</button>
								</div>
							</div>
						</div>
					</div>
					<div id="panel-core-members" class="hidden mt-8">
						<div class="mx-auto max-w-3xl space-y-6">
							<div class="border border-[#DDD5C2] bg-white/60 p-6 shadow-sm">
								<h2 class="font-serif text-xl font-semibold text-stone-900">Add core member</h2>
								<label class="mt-4 block">
									<span class="text-sm font-medium text-stone-700">Name</span>
									<input
										id="core-new-name"
										type="text"
										maxlength="120"
										placeholder="Full name"
										class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
									/>
								</label>
								<label class="mt-4 block">
									<span class="text-sm font-medium text-stone-700">Role</span>
									<input
										id="core-new-role"
										type="text"
										maxlength="120"
										placeholder="e.g. Founder & Executive Lead"
										class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
									/>
								</label>
								<label class="mt-4 block">
									<span class="text-sm font-medium text-stone-700">Description</span>
									<textarea
										id="core-new-description"
										rows="5"
										placeholder="Short bio shown on the team page"
										class="mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none"
									></textarea>
								</label>
								<label class="mt-4 block">
									<span class="text-sm font-medium text-stone-700">Photo (.jpg, .jpeg, .png or .webp, max 20MB)</span>
									<input
										id="core-new-photo"
										type="file"
										accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
										class="mt-1 block w-full text-sm text-stone-600 file:mr-3 file:rounded-[3px] file:border-0 file:bg-[#EDEFE4] file:px-4 file:py-2 file:text-sm file:font-bold file:text-[#16211B] hover:file:bg-white"
									/>
								</label>
								<div class="mt-4">
									<button
										type="button"
										id="btn-core-add"
										class="rounded-[3px] bg-[#33523B] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#26402D] disabled:opacity-50"
									>
										Add member
									</button>
								</div>
							</div>
							<div>
								<h2 class="font-serif text-xl font-semibold text-stone-900">Core members</h2>
								<p class="mt-1 text-sm text-stone-500">
									Select a member to see their photo and bio,
									then edit or remove them.
								</p>
								<div id="core-members-loading" class="mt-2 text-sm text-stone-500">Loading core members...</div>
								<div id="core-members-empty" class="mt-2 hidden text-sm text-stone-500">No core members yet.</div>
								<ul id="core-members-list" class="mt-2 hidden divide-y divide-[#E7E0CF] border border-[#DDD5C2] bg-white/60 p-4 shadow-sm"></ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>
		@siteFooter(provider.SiteName)
		<!-- Tailwind safelist for JS-created classes -->
		<span class="hidden bg-stone-200 bg-[#33523B] rounded-full px-2 py-0.5 text-xs font-semibold text-white flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 font-medium text-stone-900 shrink-0 text-sm text-stone-500 text-[#7F1D1D] disabled:opacity-50 flex items-center gap-2 rounded-[3px] bg-[#33523B] px-3 py-1.5 transition-colors hover:bg-[#26402D] bg-[#7F1D1D] hover:bg-[#671818] truncate min-w-0"></span>
		<script>
			var adminAboutURL = {{ aboutURL }};
			(function() {
				function initAdmin() {
					waitForAuthUser().then(function(user) {
					if (!user) {
						document.getElementById('admin-error').textContent = 'You must be signed in as an admin.';
						document.getElementById('admin-error').classList.remove('hidden');
						showAuthFailedToast('You must be signed in as an admin.');
						return;
					}

					var panels = {
						welcome: document.getElementById('panel-welcome'),
						publish: document.getElementById('panel-publish'),
						volumeIssue: document.getElementById('panel-volume-issue'),
						roles: document.getElementById('panel-roles'),
						blog: document.getElementById('panel-blog'),
						about: document.getElementById('panel-about'),
						team: document.getElementById('panel-team'),
						coreMembers: document.getElementById('panel-core-members')
					};
					var publishLoaded = false;
					var coreMembersLoaded = false;

					function selectSidebar(activeId) {
						document.querySelectorAll('.sidebar-item').forEach(function(btn) {
							btn.classList.remove('bg-stone-200');
						});
						document.getElementById(activeId).classList.add('bg-stone-200');
						Object.values(panels).forEach(function(p) { p.classList.add('hidden'); });
					}

					document.getElementById('sidebar-welcome').addEventListener('click', function() {
						selectSidebar('sidebar-welcome');
						panels.welcome.classList.remove('hidden');
					});

					document.getElementById('sidebar-publish').addEventListener('click', function() {
						selectSidebar('sidebar-publish');
						panels.publish.classList.remove('hidden');
						if (!publishLoaded) loadReviewedPapers();
					});

					document.getElementById('sidebar-volume-issue').addEventListener('click', function() {
						selectSidebar('sidebar-volume-issue');
						panels.volumeIssue.classList.remove('hidden');
					});

					document.getElementById('sidebar-roles').addEventListener('click', function() {
						selectSidebar('sidebar-roles');
						panels.roles.classList.remove('hidden');
					});

					document.getElementById('sidebar-blog').addEventListener('click', function() {
						selectSidebar('sidebar-blog');
						panels.blog.classList.remove('hidden');
						if (!blogLoaded) loadAdminBlogs();
					});

					document.getElementById('sidebar-about').addEventListener('click', function() {
						selectSidebar('sidebar-about');
						panels.about.classList.remove('hidden');
						if (!aboutLoaded) loadAboutContent();
					});

					document.getElementById('sidebar-team').addEventListener('click', function() {
						selectSidebar('sidebar-team');
						panels.team.classList.remove('hidden');
					});

					document.getElementById('sidebar-core-members')
						.addEventListener('click', function() {
						selectSidebar('sidebar-core-members');
						panels.coreMembers.classList.remove('hidden');
						if (!coreMembersLoaded) loadCoreMembersAdmin();
					});

					function loadReviewedPapers() {
						var loading = document.getElementById('publish-loading');
						var emptyEl = document.getElementById('publish-empty');
						var content = document.getElementById('publish-content');
						var listEl = document.getElementById('publish-list');
						var countEl = document.getElementById('publish-count');
						var badge = document.getElementById('publish-badge');
						loading.classList.remove('hidden');
						emptyEl.classList.add('hidden');
						content.classList.add('hidden');
						listEl.innerHTML = '';
						countEl.textContent = '';
						badge.classList.add('hidden');
						badge.textContent = '';
						return authFetchWithRetry('/api/v1/admin/reviewed').then(function(resp) {
							return checkApiResponse(resp, 'Failed to load reviewed papers');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							var papers = data.papers || [];

							loading.classList.add('hidden');

							if (papers.length === 0) {
								emptyEl.classList.remove('hidden');
								content.classList.add('hidden');
								badge.classList.add('hidden');
								publishLoaded = true;
								return;
							}

							emptyEl.classList.add('hidden');
							badge.textContent = papers.length;
							badge.classList.remove('hidden');
							countEl.textContent = papers.length + ' paper' + (papers.length === 1 ? '' : 's') + ' waiting to be published';
							listEl.innerHTML = '';
							papers.forEach(function(paper) {
								var li = document.createElement('li');
								li.className = 'flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6';
								var title = document.createElement('span');
								title.className = 'font-medium text-stone-900';
								title.textContent = paper.title;
								li.appendChild(title);
								if (paper.filename) {
									var fname = document.createElement('span');
									fname.className = 'shrink-0 text-sm text-stone-500';
									fname.textContent = paper.filename;
									li.appendChild(fname);
								}
								listEl.appendChild(li);
							});
							content.classList.remove('hidden');
							publishLoaded = true;
						}).catch(function(err) {
						document.getElementById('publish-loading').classList.add('hidden');
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to manage papers');
								return;
							}
							showToast(err.message);
						});
					}

					document.getElementById('btn-publish').addEventListener('click', function() {
						showToastWithActions('Publish all reviewed papers?', [
							{ label: 'Cancel', pressed: function() { hideToast(); } },
							{
								label: 'Publish',
								pressed: function() {
									hideToast();
									doPublish();
								}
							}
						]);
					});

					function doPublish() {
						var publishBtn = document.getElementById('btn-publish');
						publishBtn.disabled = true;
						authFetchWithRetry('/api/v1/admin/publish', {
							method: 'POST'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to publish papers');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							var count = data.count || 0;
							if (count === 0) {
								showToast('No papers to publish');
							} else {
								showToast(count + ' paper' + (count === 1 ? '' : 's') + ' published');
							}
							publishLoaded = false;
							loadReviewedPapers();
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to publish papers');
								return;
							}
							showToast(err.message);
						}).finally(function() {
							publishBtn.disabled = false;
						});
					}

					document.getElementById('btn-new-volume').addEventListener('click', function() {
						showToastWithActions('Create a new volume?', [
							{ label: 'Cancel', pressed: function() { hideToast(); } },
							{
								label: 'Create',
								pressed: function() {
									hideToast();
									incrementField('volume', document.getElementById('btn-new-volume'));
								}
							}
						]);
					});

					document.getElementById('btn-new-issue').addEventListener('click', function() {
						showToastWithActions('Create a new issue?', [
							{ label: 'Cancel', pressed: function() { hideToast(); } },
							{
								label: 'Create',
								pressed: function() {
									hideToast();
									incrementField('issue', document.getElementById('btn-new-issue'));
								}
							}
						]);
					});

					function incrementField(field, btn) {
						if (btn) {
							btn.disabled = true;
						}
						authFetchWithRetry('/api/v1/admin/increment?field=' + field, {
							method: 'POST'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to create ' + field);
						}).then(function() {
							showToast('New ' + field + ' created');
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to create a ' + field);
								return;
							}
							showToast(err.message);
						}).finally(function() {
							if (btn) {
								btn.disabled = false;
							}
						});
					}

					var foundUser = null;

					document.getElementById('btn-find-user').addEventListener('click', function() {
						var email = document.getElementById('role-email').value.trim();
						var findBtn = document.getElementById('btn-find-user');
						var errEl = document.getElementById('role-error');
						var resultEl = document.getElementById('role-result');
						errEl.classList.add('hidden');
						resultEl.classList.add('hidden');
						foundUser = null;
						if (!email) {
							showToast('Please enter an email address');
							return;
						}
						findBtn.disabled = true;
						fetchWithRetry('/api/v1/user?email=' + encodeURIComponent(email))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to find user');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.user) {
									throw new Error('User not found');
								}
								foundUser = data.user;
								document.getElementById('role-name').textContent = foundUser.name || '';
								document.getElementById('role-current-email').textContent = foundUser.email || '';
								var current = foundUser.role && foundUser.role.role ? foundUser.role.role : 'Unknown';
								document.getElementById('role-current').textContent = current;
								var roleSelect = document.getElementById('role-select');
								var changeBtn = document.getElementById('btn-change-role');
								var ownerNote = document.getElementById('role-owner-note');
								roleSelect.value = current;
								if (current === 'owner') {
									roleSelect.disabled = true;
									changeBtn.disabled = true;
									ownerNote.classList.remove('hidden');
								} else {
									roleSelect.disabled = false;
									changeBtn.disabled = false;
									ownerNote.classList.add('hidden');
								}
								resultEl.classList.remove('hidden');
							}).catch(function(err) {
								errEl.textContent = err.message;
								errEl.classList.remove('hidden');
							}).finally(function() {
								findBtn.disabled = false;
							});
					});

					document.getElementById('btn-change-role').addEventListener('click', function() {
						if (!foundUser || !foundUser.uuid) {
							showToast('Find a user first');
							return;
						}
						var newRole = document.getElementById('role-select').value;
						var current = foundUser.role && foundUser.role.role;
						if (current === 'owner' || newRole === 'owner') {
							showToast('The owner role cannot be changed');
							return;
						}
						if (newRole === current) {
							showToast('User already has that role');
							return;
						}
						showToastWithActions('Change ' + foundUser.email + ' role from ' + current + ' to ' + newRole + '?', [
							{ label: 'Cancel', pressed: function() { hideToast(); } },
							{
								label: 'Change',
								pressed: function() {
									hideToast();
									doChangeRole(foundUser.uuid, newRole);
								}
							}
						]);
					});

					function doChangeRole(userUuid, newRole) {
						var btn = document.getElementById('btn-change-role');
						btn.disabled = true;
						authFetchWithRetry('/api/v1/admin/role/' + encodeURIComponent(userUuid) + '?role=' + encodeURIComponent(newRole), {
							method: 'PATCH'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to change role');
						}).then(function() {
							document.getElementById('role-current').textContent = newRole;
							if (foundUser) {
								foundUser.role = { role: newRole };
							}
							showToast('Role changed to ' + newRole);
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to change roles');
								return;
							}
							showToast(err.message);
						}).finally(function() {
							btn.disabled = false;
						});
					}

					var foundTeamUser = null;

					document.getElementById('btn-find-team-user').addEventListener('click', function() {
						var email = document.getElementById('team-email').value.trim();
						var findBtn = document.getElementById('btn-find-team-user');
						var errEl = document.getElementById('team-error');
						var resultEl = document.getElementById('team-result');
						errEl.classList.add('hidden');
						resultEl.classList.add('hidden');
						foundTeamUser = null;
						if (!email) {
							showToast('Please enter an email address');
							return;
						}
						findBtn.disabled = true;
						fetchWithRetry('/api/v1/user?email=' + encodeURIComponent(email))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to find user');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.user) {
									throw new Error('User not found');
								}
								foundTeamUser = data.user;
								document.getElementById('team-name').textContent = foundTeamUser.name || '';
								document.getElementById('team-current-email').textContent = foundTeamUser.email || '';
								document.getElementById('team-current-lead').textContent = foundTeamUser.city_lead || 'None';
								document.getElementById('team-input').value = foundTeamUser.city_lead || '';
								resultEl.classList.remove('hidden');
							}).catch(function(err) {
								errEl.textContent = err.message;
								errEl.classList.remove('hidden');
							}).finally(function() {
								findBtn.disabled = false;
							});
					});

					document.getElementById('btn-save-team-lead').addEventListener('click', function() {
						if (!foundTeamUser || !foundTeamUser.uuid) {
							showToast('Find a user first');
							return;
						}
						var cityLead = document.getElementById('team-input').value.trim();
						if (!cityLead) {
							showToast('Please enter a city');
							return;
						}
						doEditCityLead(foundTeamUser.uuid, cityLead);
					});

					document.getElementById('btn-clear-team-lead').addEventListener('click', function() {
						if (!foundTeamUser || !foundTeamUser.uuid) {
							showToast('Find a user first');
							return;
						}
						showToastWithActions('Clear city lead for ' + foundTeamUser.email + '?', [
							{ label: 'Cancel', pressed: function() { hideToast(); } },
							{
								label: 'Clear',
								danger: true,
								pressed: function() {
									hideToast();
									doEditCityLead(foundTeamUser.uuid, null);
								}
							}
						]);
					});

					function doEditCityLead(userUuid, cityLead) {
						var saveBtn = document.getElementById('btn-save-team-lead');
						var clearBtn = document.getElementById('btn-clear-team-lead');
						saveBtn.disabled = true;
						clearBtn.disabled = true;
						var url = '/api/v1/admin/city/' + encodeURIComponent(userUuid);
						if (cityLead) {
							url += '?city=' + encodeURIComponent(cityLead);
						}
						authFetchWithRetry(url, {
							method: 'PATCH'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to update city lead');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (data && data.user) {
								foundTeamUser = data.user;
							}
							var current = (foundTeamUser && foundTeamUser.city_lead) || 'None';
							document.getElementById('team-current-lead').textContent = current;
							document.getElementById('team-input').value = (foundTeamUser && foundTeamUser.city_lead) || '';
							showToast(cityLead ? 'City lead saved' : 'City lead cleared');
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to edit city leads');
								return;
							}
							showToast(err.message);
						}).finally(function() {
							saveBtn.disabled = false;
							clearBtn.disabled = false;
						});
					}

					var blogLoaded = false;
					var editingBlogUuid = null;
					var editingBlogContent = null;

					function formatAdminBlogDate(unix) {
						return new Date(unix * 1000).toLocaleDateString(undefined, {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						});
					}

					function renderAdminMarkdown(md) {
						if (typeof marked === 'undefined' || typeof DOMPurify === 'undefined') {
							throw new Error('Markdown renderer failed to load');
						}
						return DOMPurify.sanitize(marked.parse(md || ''));
					}

					function resetBlogEditor() {
						editingBlogUuid = null;
						editingBlogContent = null;
						document.getElementById('blog-title').value = '';
						document.getElementById('blog-editor').value = '';
						document.getElementById('blog-preview').innerHTML = '';
						document.getElementById('blog-editor-heading').textContent = 'New post';
						document.getElementById('btn-blog-save').textContent = 'Publish post';
						document.getElementById('btn-blog-cancel').classList.add('hidden');
					}

					document.getElementById('blog-editor').addEventListener('input', function() {
						try {
							document.getElementById('blog-preview').innerHTML = renderAdminMarkdown(this.value);
						} catch (e) {
							document.getElementById('blog-preview').textContent = 'Preview unavailable: ' + e.message;
						}
					});

					function loadAdminBlogs() {
						var loading = document.getElementById('blog-admin-loading');
						var emptyEl = document.getElementById('blog-admin-empty');
						var listEl = document.getElementById('blog-admin-list');
						loading.classList.remove('hidden');
						emptyEl.classList.add('hidden');
						listEl.classList.add('hidden');
						listEl.innerHTML = '';
						fetchWithRetry('/api/v1/blogs')
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load posts');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								var blogs = data.blogs || [];
								loading.classList.add('hidden');
								if (blogs.length === 0) {
									emptyEl.classList.remove('hidden');
									blogLoaded = true;
									return;
								}
								blogs.forEach(function(blog) {
									var li = document.createElement('li');
									li.className = 'flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6';
									var left = document.createElement('div');
									left.className = 'min-w-0';
									var title = document.createElement('div');
									title.className = 'truncate font-medium text-stone-900';
									title.textContent = blog.title;
									left.appendChild(title);
									var date = document.createElement('div');
									date.className = 'text-sm text-stone-500';
									date.textContent = formatAdminBlogDate(blog.created_at);
									left.appendChild(date);
									li.appendChild(left);
									var actions = document.createElement('div');
									actions.className = 'flex shrink-0 items-center gap-2';
									var editBtn = document.createElement('button');
									editBtn.type = 'button';
									editBtn.textContent = 'Edit';
									editBtn.className = 'shrink-0 rounded-[3px] bg-[#33523B] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#26402D]';
									editBtn.addEventListener('click', function() {
										editBlog(blog.uuid);
									});
									actions.appendChild(editBtn);
									var deleteBtn = document.createElement('button');
									deleteBtn.type = 'button';
									deleteBtn.textContent = 'Delete';
									deleteBtn.className = 'shrink-0 rounded-[3px] bg-[#7F1D1D] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#671818]';
									deleteBtn.addEventListener('click', function() {
										confirmDeleteBlog(blog.uuid, blog.title, li);
									});
									actions.appendChild(deleteBtn);
									li.appendChild(actions);
									listEl.appendChild(li);
								});
								listEl.classList.remove('hidden');
								blogLoaded = true;
							}).catch(function(err) {
								loading.classList.add('hidden');
								showToast(err.message);
							});
					}

					function editBlog(blogUuid) {
						fetchWithRetry('/api/v1/blogs/' + encodeURIComponent(blogUuid))
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load post');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.blog || !data.blog.uuid) {
									throw new Error('Post not found');
								}
								var blog = data.blog;
								return fetchWithRetry('/api/v1/blogs/' + encodeURIComponent(blog.uuid) + '/content')
									.then(function(resp) {
										return checkApiResponse(resp, 'Failed to load post content');
									}).then(function(resp) {
										return resp.text();
									}).then(function(md) {
										editingBlogUuid = blog.uuid;
										editingBlogContent = md;
										document.getElementById('blog-title').value = blog.title;
										document.getElementById('blog-editor').value = md;
										try {
											document.getElementById('blog-preview').innerHTML = renderAdminMarkdown(md);
										} catch (e) {
											document.getElementById('blog-preview').textContent = 'Preview unavailable: ' + e.message;
										}
										document.getElementById('blog-editor-heading').textContent = 'Edit post';
										document.getElementById('btn-blog-save').textContent = 'Save changes';
										document.getElementById('btn-blog-cancel').classList.remove('hidden');
										document.getElementById('blog-title').scrollIntoView({ behavior: 'smooth', block: 'center' });
									});
							}).catch(function(err) {
								showToast(err.message);
							});
					}

					document.getElementById('btn-blog-cancel').addEventListener('click', function() {
						resetBlogEditor();
					});

					document.getElementById('btn-blog-save').addEventListener('click', function() {
						var title = document.getElementById('blog-title').value.trim();
						var content = document.getElementById('blog-editor').value;
						var saveBtn = document.getElementById('btn-blog-save');
						if (!title) {
							showToast('Please enter a title');
							return;
						}
						if (!content.trim()) {
							showToast('Please write some content');
							return;
						}
						saveBtn.disabled = true;
						// Post content goes direct to the object store via a
						// presigned URL; only metadata passes through the API.
						function putContent(uploadUrl, content) {
							return fetchWithRetry(uploadUrl, {
								method: 'PUT',
								headers: { 'Content-Type': 'text/markdown; charset=utf-8' },
								body: content
							}).then(function(putResp) {
								return checkApiResponse(putResp, 'Failed to upload content');
							});
						}
						function failBlogSave(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to manage posts');
								return;
							}
							showToast(err.message);
						}
						function finishBlogSave(message) {
							resetBlogEditor();
							blogLoaded = false;
							loadAdminBlogs();
							showToast(message);
						}
						var request;
						if (editingBlogUuid) {
							if (content === editingBlogContent) {
								request = authFetchWithRetry('/api/v1/admin/blog/' + encodeURIComponent(editingBlogUuid), {
									method: 'PATCH',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ title: title })
								}).then(function(resp) {
									return checkApiResponse(resp, 'Failed to update post');
								}).then(function() {
									finishBlogSave('Post updated');
								});
							} else {
								request = authFetchWithRetry('/api/v1/admin/blog/' + encodeURIComponent(editingBlogUuid) + '/upload-url', {
									method: 'POST'
								}).then(function(resp) {
									return checkApiResponse(resp, 'Failed to start upload');
								}).then(function(resp) {
									return resp.json();
								}).then(function(data) {
									if (!data || !data.upload_url) {
										throw new Error('Failed to start upload: bad upload response');
									}
									return putContent(data.upload_url, content);
								}).then(function() {
									return authFetchWithRetry('/api/v1/admin/blog/' + encodeURIComponent(editingBlogUuid), {
										method: 'PATCH',
										headers: { 'Content-Type': 'application/json' },
										body: JSON.stringify({ title: title, content_replaced: true })
									});
								}).then(function(resp) {
									return checkApiResponse(resp, 'Failed to update post');
								}).then(function() {
									finishBlogSave('Post updated');
								});
							}
						} else {
							request = authFetchWithRetry('/api/v1/admin/blog/upload-url', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ title: title })
							}).then(function(resp) {
								return checkApiResponse(resp, 'Failed to start upload');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								if (!data || !data.uuid || !data.upload_url) {
									throw new Error('Failed to start upload: bad upload response');
								}
								return putContent(data.upload_url, content).then(function() {
									return data.uuid;
								});
							}).then(function(blogUUID) {
								return authFetchWithRetry('/api/v1/admin/blog/confirm', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ uuid: blogUUID, title: title })
								});
							}).then(function(resp) {
								return checkApiResponse(resp, 'Failed to publish post');
							}).then(function() {
								finishBlogSave('Post published');
							});
						}
						request.catch(failBlogSave).finally(function() {
							saveBtn.disabled = false;
						});
					});

					function confirmDeleteBlog(blogUuid, title, row) {
						showToastWithActions('Delete "' + title + '"?', [
							{
								label: 'Cancel',
								pressed: function() {
									hideToast();
								}
							},
							{
								label: 'Delete',
								danger: true,
								pressed: function() {
									hideToast();
									doDeleteBlog(blogUuid, row);
								}
							}
						]);
					}

					function doDeleteBlog(blogUuid, row) {
						authFetchWithRetry('/api/v1/admin/blog/' + encodeURIComponent(blogUuid), {
							method: 'DELETE'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to delete post');
						}).then(function() {
							row.remove();
							var listEl = document.getElementById('blog-admin-list');
							var emptyEl = document.getElementById('blog-admin-empty');
							if (listEl.children.length === 0) {
								listEl.classList.add('hidden');
								emptyEl.classList.remove('hidden');
							}
							showToast('Post deleted');
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to delete posts');
								return;
							}
							showToast(err.message);
						});
					}

					var aboutLoaded = false;

					document.getElementById('about-editor').addEventListener('input', function() {
						try {
							document.getElementById('about-preview').innerHTML = renderAdminMarkdown(this.value);
						} catch (e) {
							document.getElementById('about-preview').textContent = 'Preview unavailable: ' + e.message;
						}
					});

					function loadAboutContent() {
						var loading = document.getElementById('about-admin-loading');
						loading.classList.remove('hidden');
						fetchWithRetry(adminAboutURL)
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load about page');
							}).then(function(resp) {
								return resp.text();
							}).then(function(md) {
								document.getElementById('about-editor').value = md;
								try {
									document.getElementById('about-preview').innerHTML = renderAdminMarkdown(md);
								} catch (e) {
									document.getElementById('about-preview').textContent = 'Preview unavailable: ' + e.message;
								}
								loading.classList.add('hidden');
								aboutLoaded = true;
							}).catch(function(err) {
								loading.classList.add('hidden');
								showToast(err.message);
							});
					}

					document.getElementById('btn-about-save').addEventListener('click', function() {
						var content = document.getElementById('about-editor').value;
						var saveBtn = document.getElementById('btn-about-save');
						if (!content.trim()) {
							showToast('Please write some content');
							return;
						}
						saveBtn.disabled = true;
						authFetchWithRetry('/api/v1/admin/about/upload-url', {
							method: 'POST'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to start upload');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.upload_url) {
								throw new Error('Failed to start upload: bad upload response');
							}
							return fetchWithRetry(data.upload_url, {
								method: 'PUT',
								headers: { 'Content-Type': 'text/markdown; charset=utf-8' },
								body: content
							}).then(function(putResp) {
								return checkApiResponse(putResp, 'Failed to upload content');
							});
						}).then(function() {
							return authFetchWithRetry('/api/v1/admin/about/confirm', {
								method: 'PUT'
							});
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to save about page');
						}).then(function() {
							showToast('About page saved');
						}).catch(function(err) {
							if (isSessionExpiredError(err)) {
								handleSessionExpired();
								return;
							}
							if (err && err.status === 403) {
								showToast('You are not allowed to edit the about page');
								return;
							}
							showToast(err.message);
						}).finally(function() {
							saveBtn.disabled = false;
						});
					});

					var coreUuidPattern = /^[0-9a-fA-F-]{36}$/;

					function corePhotoExtFromName(name) {
						var idx = name.lastIndexOf('.');
						if (idx < 0) {
							return '';
						}
						return name.slice(idx).toLowerCase();
					}

					function corePhotoContentType(ext, file) {
						if (file && file.type && file.type.indexOf('image/') === 0) {
							return file.type;
						}
						if (ext === '.png') {
							return 'image/png';
						}
						if (ext === '.webp') {
							return 'image/webp';
						}
						return 'image/jpeg';
					}

					function failCoreMember(err, fallback) {
						if (isSessionExpiredError(err)) {
							handleSessionExpired();
							return;
						}
						if (err && err.status === 403) {
							showToast('You are not allowed to manage core members');
							return;
						}
						showToast((err && err.message) || fallback || 'Request failed');
					}

					function coreMemberValid(member) {
						return member &&
							typeof member.uuid === 'string' &&
							coreUuidPattern.test(member.uuid) &&
							typeof member.name === 'string' &&
							member.name &&
							typeof member.role === 'string' &&
							member.role &&
							typeof member.description === 'string' &&
							member.description;
					}

					function coreTextInput(value, placeholder) {
						var input = document.createElement('input');
						input.type = 'text';
						input.maxLength = 120;
						input.placeholder = placeholder;
						input.value = value || '';
						input.className = 'mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none';
						return input;
					}

					function loadCoreMembersAdmin() {
						var loading = document.getElementById('core-members-loading');
						var emptyEl = document.getElementById('core-members-empty');
						var listEl = document.getElementById('core-members-list');
						loading.classList.remove('hidden');
						emptyEl.classList.add('hidden');
						listEl.classList.add('hidden');
						listEl.innerHTML = '';
						fetchWithRetry('/api/v1/core-members')
							.then(function(resp) {
								return checkApiResponse(resp, 'Failed to load core members');
							}).then(function(resp) {
								return resp.json();
							}).then(function(data) {
								var raw = (data && data.core_members) || [];
								var members = Array.isArray(raw) ? raw : [];
								members = members.filter(coreMemberValid);
								loading.classList.add('hidden');
								if (!members.length) {
									emptyEl.classList.remove('hidden');
									coreMembersLoaded = true;
									return;
								}
								members.forEach(function(member) {
									listEl.appendChild(coreMemberRow(member));
								});
								listEl.classList.remove('hidden');
								coreMembersLoaded = true;
							}).catch(function(err) {
								loading.classList.add('hidden');
								showToast(err.message);
							});
					}

					function coreMemberRow(member) {
						var li = document.createElement('li');
						li.className = 'flex flex-col gap-1 py-3';

						var header = document.createElement('button');
						header.type = 'button';
						header.className = 'flex w-full items-center justify-between gap-4 text-left';
						var left = document.createElement('div');
						left.className = 'min-w-0';
						var nameEl = document.createElement('div');
						nameEl.className = 'truncate font-medium text-stone-900';
						nameEl.textContent = member.name;
						left.appendChild(nameEl);
						var roleEl = document.createElement('div');
						roleEl.className = 'truncate text-sm text-stone-500';
						roleEl.textContent = member.role;
						left.appendChild(roleEl);
						header.appendChild(left);
						var toggle = document.createElement('span');
						toggle.className = 'shrink-0 text-sm text-stone-500';
						toggle.textContent = 'Show';
						header.appendChild(toggle);
						li.appendChild(header);

						var details = document.createElement('div');
						details.className = 'hidden mt-3 space-y-3 border-t border-stone-100 pt-3';

						var img = document.createElement('img');
						img.className = 'h-24 w-24 rounded-[3px] object-cover';
						img.alt = member.name || 'Core member';
						if (typeof member.image_url === 'string' && member.image_url) {
							img.src = member.image_url;
						}
						details.appendChild(img);

						var nameLabel = document.createElement('label');
						nameLabel.className = 'block';
						var nameSpan = document.createElement('span');
						nameSpan.className = 'text-sm font-medium text-stone-700';
						nameSpan.textContent = 'Name';
						nameLabel.appendChild(nameSpan);
						var nameInput = coreTextInput(member.name, 'Full name');
						nameLabel.appendChild(nameInput);
						details.appendChild(nameLabel);

						var roleLabel = document.createElement('label');
						roleLabel.className = 'block';
						var roleSpan = document.createElement('span');
						roleSpan.className = 'text-sm font-medium text-stone-700';
						roleSpan.textContent = 'Role';
						roleLabel.appendChild(roleSpan);
						var roleInput = coreTextInput(member.role, 'Role');
						roleLabel.appendChild(roleInput);
						details.appendChild(roleLabel);

						var descLabel = document.createElement('label');
						descLabel.className = 'block';
						var descSpan = document.createElement('span');
						descSpan.className = 'text-sm font-medium text-stone-700';
						descSpan.textContent = 'Description';
						descLabel.appendChild(descSpan);
						var descInput = document.createElement('textarea');
						descInput.rows = 5;
						descInput.value = member.description || '';
						descInput.className = 'mt-1 w-full rounded-[3px] border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 focus:border-[#33523B] focus:outline-none';
						descLabel.appendChild(descInput);
						details.appendChild(descLabel);

						var textRow = document.createElement('div');
						textRow.className = 'flex shrink-0 items-center gap-2';
						var saveBtn = document.createElement('button');
						saveBtn.type = 'button';
						saveBtn.textContent = 'Save text';
						saveBtn.className = 'shrink-0 rounded-[3px] bg-[#33523B] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#26402D] disabled:opacity-50';
						saveBtn.addEventListener('click', function() {
							saveCoreMemberText(
								member.uuid,
								nameInput.value,
								roleInput.value,
								descInput.value,
								saveBtn,
								nameEl,
								roleEl
							);
						});
						textRow.appendChild(saveBtn);
						var deleteBtn = document.createElement('button');
						deleteBtn.type = 'button';
						deleteBtn.textContent = 'Remove';
						deleteBtn.className = 'shrink-0 rounded-[3px] bg-[#7F1D1D] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-[#671818] disabled:opacity-50';
						deleteBtn.addEventListener('click', function() {
							confirmDeleteCoreMember(member.uuid, member.name, li);
						});
						textRow.appendChild(deleteBtn);
						details.appendChild(textRow);

						var photoLabel = document.createElement('label');
						photoLabel.className = 'block';
						var photoSpan = document.createElement('span');
						photoSpan.className = 'text-sm font-medium text-stone-700';
						photoSpan.textContent = 'New photo (.jpg, .jpeg, .png or .webp, max 5MB)';
						photoLabel.appendChild(photoSpan);
						var photoInput = document.createElement('input');
						photoInput.type = 'file';
						photoInput.accept = '.jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp';
						photoInput.className = 'mt-1 block w-full text-sm text-stone-600 file:mr-3 file:rounded-[3px] file:border-0 file:bg-[#EDEFE4] file:px-4 file:py-2 file:text-sm file:font-bold file:text-[#16211B] hover:file:bg-white';
						photoLabel.appendChild(photoInput);
						details.appendChild(photoLabel);

						var photoBtn = document.createElement('button');
						photoBtn.type = 'button';
						photoBtn.textContent = 'Save photo';
						photoBtn.className = 'shrink-0 rounded-[3px] bg-[#1C1917] px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-stone-700 disabled:opacity-50';
						photoBtn.addEventListener('click', function() {
							saveCoreMemberPhoto(member.uuid, photoInput, img, photoBtn);
						});
						details.appendChild(photoBtn);

						header.addEventListener('click', function() {
							var open = details.classList.toggle('hidden');
							toggle.textContent = open ? 'Show' : 'Hide';
						});
						li.appendChild(details);
						return li;
					}

					function saveCoreMemberText(
						memberUuid, name, role, description,
						btn, nameEl, roleEl
					) {
						if (!coreUuidPattern.test(memberUuid)) {
							showToast('Invalid member');
							return;
						}
						if (!name.trim() || !role.trim() || !description.trim()) {
							showToast('Name, role and description are required');
							return;
						}
						btn.disabled = true;
						var textPath = '/api/v1/admin/core-members/' +
							encodeURIComponent(memberUuid);
						authFetchWithRetry(textPath, {
							method: 'PATCH',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								name: name.trim(),
								role: role.trim(),
								description: description.trim()
							})
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to update member');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (data && data.member) {
								nameEl.textContent = data.member.name || name.trim();
								roleEl.textContent = data.member.role || role.trim();
							} else {
								nameEl.textContent = name.trim();
								roleEl.textContent = role.trim();
							}
							coreMembersLoaded = false;
							showToast('Member updated');
						}).catch(function(err) {
							failCoreMember(err, 'Failed to update member');
						}).finally(function() {
							btn.disabled = false;
						});
					}

					function saveCoreMemberPhoto(memberUuid, fileInput, img, btn) {
						if (!coreUuidPattern.test(memberUuid)) {
							showToast('Invalid member');
							return;
						}
						if (!fileInput.files || !fileInput.files.length) {
							showToast('Please choose a photo');
							return;
						}
						var file = fileInput.files[0];
						var ext = corePhotoExtFromName(file.name);
						if (ext !== '.jpg' && ext !== '.jpeg' &&
							ext !== '.png' && ext !== '.webp') {
							showToast('Photo must be a .jpg, .jpeg, .png or .webp image');
							return;
						}
						if (file.size <= 0 || file.size > 5 * 1024 * 1024) {
							showToast('Photo must be non-empty and at most 5MB');
							return;
						}
						btn.disabled = true;
						var photoUrlPath = '/api/v1/admin/core-members/' +
							encodeURIComponent(memberUuid) +
							'/photo/upload-url';
						authFetchWithRetry(photoUrlPath, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ extension: ext })
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to start upload');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.image_filename || !data.upload_url) {
								throw new Error('Failed to start upload: bad upload response');
							}
							return fetchWithRetry(data.upload_url, {
								method: 'PUT',
								headers: { 'Content-Type': corePhotoContentType(ext, file) },
								body: file
							}).then(function(putResp) {
								return checkApiResponse(putResp, 'Failed to upload photo');
							}).then(function() {
								return data.image_filename;
							});
						}).then(function(imageFilename) {
							var photoConfirmPath =
								'/api/v1/admin/core-members/' +
								encodeURIComponent(memberUuid) +
								'/photo/confirm';
							return authFetchWithRetry(photoConfirmPath, {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ image_filename: imageFilename })
							}).then(function(resp) {
								return checkApiResponse(resp, 'Failed to save photo');
							}).then(function(resp) {
								return resp.json();
							});
						}).then(function(data) {
							if (data && data.member && data.member.image_url) {
								img.src = data.member.image_url;
							}
							fileInput.value = '';
							coreMembersLoaded = false;
							loadCoreMembersAdmin();
							showToast('Photo updated');
						}).catch(function(err) {
							failCoreMember(err, 'Failed to save photo');
						}).finally(function() {
							btn.disabled = false;
						});
					}

					function confirmDeleteCoreMember(memberUuid, name, row) {
						showToastWithActions('Remove "' + name + '" from core members?', [
							{
								label: 'Cancel',
								pressed: function() {
									hideToast();
								}
							},
							{
								label: 'Remove',
								danger: true,
								pressed: function() {
									hideToast();
									doDeleteCoreMember(memberUuid, row);
								}
							}
						]);
					}

					function doDeleteCoreMember(memberUuid, row) {
						var deletePath = '/api/v1/admin/core-members/' +
							encodeURIComponent(memberUuid);
						authFetchWithRetry(deletePath, {
							method: 'DELETE'
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to remove member');
						}).then(function() {
							row.remove();
							var listEl = document.getElementById('core-members-list');
							var emptyEl = document.getElementById('core-members-empty');
							if (!listEl.children.length) {
								listEl.classList.add('hidden');
								emptyEl.classList.remove('hidden');
							}
							coreMembersLoaded = false;
							showToast('Member removed');
						}).catch(function(err) {
							failCoreMember(err, 'Failed to remove member');
						});
					}

					var addBtn = document.getElementById('btn-core-add');
					addBtn.addEventListener('click', function() {
						var name = document.getElementById('core-new-name').value.trim();
						var role = document.getElementById('core-new-role').value.trim();
						var description = document.getElementById(
							'core-new-description'
						).value.trim();
						var fileInput = document.getElementById('core-new-photo');
						if (!name || !role || !description) {
							showToast('Name, role and description are required');
							return;
						}
						if (!fileInput.files || !fileInput.files.length) {
							showToast('Please choose a photo');
							return;
						}
						var file = fileInput.files[0];
						var ext = corePhotoExtFromName(file.name);
						if (ext !== '.jpg' && ext !== '.jpeg' &&
							ext !== '.png' && ext !== '.webp') {
							showToast('Photo must be a .jpg, .jpeg, .png or .webp image');
							return;
						}
						if (file.size <= 0 || file.size > 5 * 1024 * 1024) {
							showToast('Photo must be non-empty and at most 5MB');
							return;
						}
						addBtn.disabled = true;
						authFetchWithRetry('/api/v1/admin/core-members/upload-url', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ extension: ext })
						}).then(function(resp) {
							return checkApiResponse(resp, 'Failed to start upload');
						}).then(function(resp) {
							return resp.json();
						}).then(function(data) {
							if (!data || !data.uuid || !data.image_filename || !data.upload_url) {
								throw new Error('Failed to start upload: bad upload response');
							}
							return fetchWithRetry(data.upload_url, {
								method: 'PUT',
								headers: { 'Content-Type': corePhotoContentType(ext, file) },
								body: file
							}).then(function(putResp) {
								return checkApiResponse(putResp, 'Failed to upload photo');
							}).then(function() {
								return data;
							});
						}).then(function(data) {
							return authFetchWithRetry('/api/v1/admin/core-members/confirm', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									uuid: data.uuid,
									name: name,
									role: role,
									description: description,
									image_filename: data.image_filename
								})
							}).then(function(resp) {
								return checkApiResponse(resp, 'Failed to add member');
							});
						}).then(function() {
							document.getElementById('core-new-name').value = '';
							document.getElementById('core-new-role').value = '';
							document.getElementById('core-new-description').value = '';
							fileInput.value = '';
							coreMembersLoaded = false;
							loadCoreMembersAdmin();
							showToast('Member added');
						}).catch(function(err) {
							failCoreMember(err, 'Failed to add member');
						}).finally(function() {
							addBtn.disabled = false;
						});
					});
					});
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initAdmin);
				} else {
					initAdmin();
				}
			})();
		</script>
	</div>
}

templ AdminDashboardPage(firebaseClientConfig map[string]any, aboutURL string) {
	@base(adminInfo, adminPage(aboutURL), firebaseClientConfig)
}
